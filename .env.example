# Copia in `.env` e riempi i valori reali. `.env` è in .gitignore — NON committarlo.

# ─── Database (già esistente) ─────────────────────────────────────────────────
DATABASE_URL=postgres://user@/automotoradar?host=/tmp

# ─── Bot WhatsApp (Meta Cloud API) ────────────────────────────────────────────
# Dalla dashboard Meta → App → WhatsApp → API Setup / Impostazioni.
WHATSAPP_VERIFY_TOKEN=       # stringa a piacere; deve combaciare con la dashboard (webhook)
WHATSAPP_APP_SECRET=         # Impostazioni → Basic → App Secret (per la firma X-Hub-Signature-256)
WHATSAPP_TOKEN=              # token permanente Graph API (System User)
WHATSAPP_PHONE_NUMBER_ID=    # ID del numero (test o business)
WHATSAPP_ALLOWED_SENDERS=    # csv numeri autorizzati, es. 393520727252 (vuoto = nessun filtro app-level)
# GRAPH_API_VERSION=v22.0    # opzionale, override versione Graph
# WA_WEB_SEARCH=1            # 1 (default) abilita il tool web_search (info generiche); 0 lo disattiva
# WA_OEM_LOOKUP=1           # 1 (default) abilita il tool oem_lookup (codice OEM → articoli via auto-doc); 0 lo disattiva
# WA_DRY_RUN=1               # 1 = non chiama Meta, logga/scrive i PDF (test locale). Lascia vuoto in prod.
# WA_DEV_DUMP_DIR=           # cartella dove scrivere i PDF quando WA_DRY_RUN=1

# ─── Cervello LLM (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=           # chiave API Anthropic
# BOT_MODEL=claude-sonnet-5  # opzionale; claude-haiku-4-5 per abbattere il costo
