# Variabili d'ambiente di AMR. Valori di esempio: nessun segreto reale qui.
# `.env` è in .gitignore — NON committarlo.
#
# `.env` lo caricano solo `backend/server.js` (sviluppo locale, app desktop) e
# `scripts/utenti-da-env.js`. Il centro (`backend/nodi/centro-run.js`) e i worker
# leggono soltanto l'ambiente impostato dalla piattaforma o dal launcher: lì
# `.env` non conta.

# ─── App locale: backend/server.js ────────────────────────────────────────────
# PORT=3000                     # porta HTTP (default 3000)
# USER_DATA_PATH=               # cartella dati persistenti (auth.json, db, cache)
# AMR_LOG_DIR=                  # cartella dei log; default <USER_DATA_PATH>/logs
# LOG_LEVEL=info                # debug | info | warn | error (DEBUG=1 equivale a debug)
# AMR_BUDGET_TETTO=20           # soglia di richieste per ricerca oltre cui si scrive un avviso (non limita)
# AMR_SUBITO_TESTO=1            # 1 = Subito cerca per testo invece che per nodo del catalogo
# AMR_PONTE_AS24=0              # 0 disattiva il ponte modelli Subito→AutoScout24
# AMR_PONTE_BUCHI=0             # 0 disattiva l'aggancio dei modelli mancanti nel catalogo Subito
# AMR_MOTORNET=1                # Motornet: spento di default, NON per un prodotto distribuito
# AMR_URL_PUBBLICO=             # solo nell'ambiente di scripts/richieste.js (non da .env): indirizzo dei link d'invito

# ─── Accessi dell'app locale: node scripts/utenti-da-env.js ──────────────────
# Lo script rispecchia questo elenco in auth.json: chi non c'è più non entra più.
# AMR_ADMIN_PASSWORD=           # password del proprietario
# AMR_UTENTE_01=Nome Cognome:password          # sola lettura
# AMR_UTENTE_02=Nome Cognome:password:piena    # può anche scrivere
# AMR_AUTH_ANCHE=               # altre cartelle dove copiare auth.json (locali o utente@host:/percorso)
# AMR_AUTH_SSH_KEY=             # chiave SSH per le destinazioni remote (facoltativa)

# ─── Centro in cloud: backend/nodi/centro-run.js (Node 24) ────────────────────
# Obbligatorie (la configurazione viene rifiutata se mancano o non sono valide):
# AMR_CENTRO_ORIGINE=https://app.example.invalid      # origine pubblica esatta, solo https
# AMR_NHOST_AUTH_URL=https://auth.example.invalid/v1  # Nhost Auth, percorso /v1
# AMR_NODI_TOKENS={"imac":"<64 hex>","m2":"<64 hex>"} # un token distinto per nodo
# AMR_NODI_RELEASE_FILE=/app/release.json             # percorso assoluto del manifest
# AMR_NODI_DATA_DIR=/var/lib/amr                      # percorso assoluto del volume
# AMR_CENTRO_REPLICHE=1                               # deve essere 1 (sessioni in RAM)
# AMR_CENTRO_INGRESS=nhost      # oppure AMR_CENTRO_PROXY_IP=<ip,...> (mai entrambi)
# AMR_PG_HOST=postgres-service
# AMR_PG_DATABASE=postgres
# AMR_PG_LETTURA_USER=          # tre ruoli distinti, password di almeno 16 caratteri
# AMR_PG_LETTURA_PASSWORD=
# AMR_PG_COMMERCIALE_USER=
# AMR_PG_COMMERCIALE_PASSWORD=
# AMR_PG_BACKUP_USER=
# AMR_PG_BACKUP_PASSWORD=
# Facoltative:
# PORT=3000
# AMR_PG_PORT=5432
# AMR_PG_RETE_PRIVATA=1         # 1 = Postgres su rete privata senza TLS (solo postgres-service)
# AMR_CENTRO_PROPRIETARIO_ID=   # UUID Nhost del proprietario (ricerca diagnostica personale)
# AMR_BETTERSTACK_WEBHOOK_URL=  # webhook per le notifiche di incidente
# AMR_NODI_RICERCA_TIMEOUT_MS=60000   # massimo 60000
# AMR_NODI_RICERCHE_MAX_PERSONA=2     # massimo 2
# AMR_NODI_RICERCHE_MAX_TOTALE=60     # massimo 60

# ─── Copie di backup del centro (restic → Cloudflare R2) ─────────────────────
# Tutte o nessuna: una configurazione parziale viene rifiutata.
# Senza queste variabili il centro parte SENZA backup.
# AMR_COPIE_SEGRETI=            # JSON con i segreti, in alternativa ai file qui sotto
# AMR_COPIE_R2_ENV=             # file con le credenziali R2 (percorso assoluto)
# AMR_COPIE_PASSWORD_FILE=      # password del repository restic (percorso assoluto)
# AMR_COPIE_PG_PASSFILE=        # pgpass del ruolo di dump (percorso assoluto)
# AMR_COPIE_PG_USER=amr_dump
# AMR_COPIE_RESTIC=/usr/local/bin/restic
# AMR_COPIE_RESTIC_SHA256=      # sha256 del binario restic
# AMR_COPIE_PG_DUMP=/usr/bin/pg_dump
# AMR_COPIE_PG_DUMP_SHA256=     # sha256 del binario pg_dump
# AMR_COPIE_REPOSITORY={"endpoint":"https://<32 hex>.eu.r2.cloudflarestorage.com","database":{"bucket":"...","id":"<64 hex>"},"journal":{"bucket":"...","id":"<64 hex>"}}

# ─── Nodo / worker: backend/nodi/worker.js ───────────────────────────────────
# AMR_CENTRO_URL=https://app.example.invalid
# AMR_NODO_ID=imac
# AMR_NODI_TOKEN=<64 hex>       # lo stesso valore della voce del nodo in AMR_NODI_TOKENS
# AMR_NODI_RELEASE_FILE=        # manifest della stessa release del centro
# AMR_NODO_SIMULATO=1           # 1 = risposte simulate, nessuna chiamata alle fonti
# AMR_NODO_SOLO_STATO=1         # 1 = il nodo invia solo lo stato, non esegue lavori

# ─── Solo prototipo locale del centro (node backend/nodi/centro.js) ──────────
# AMR_CENTRO_PORT=47360
# AMR_NODI_ADMIN_LOCALE=1

# ─── Test opt-in (non servono per npm test) ──────────────────────────────────
# AMR_TEST_CHROMIUM=            # Chromium per i test UI se quello di Playwright manca
# AMR_TEST_DOCKER_HOST=         # abilita i test PostgreSQL in Docker
# AMR_TEST_BACKUP_DOCKER_HOST=  # abilita i test di backup in Docker
# AMR_TEST_RESTIC=              # abilita i test restic (con AMR_TEST_RESTIC_SHA256)
