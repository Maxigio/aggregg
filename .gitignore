node_modules/
.env
.DS_Store
dist/
pw-browsers/
.claude/
._*

# Artefatti build icona (rigenerabili da electron/icon.svg)
electron/icon.png
electron/icon.iconset/

# Librerie frontend vendor (generate da scripts/bundle-vendor.js via postinstall)
frontend/vendor/

# Session storage Subito (bootstrap interattivo, contiene cookie DataDome)
data/.subito-session.json
data/models.json.bak

# Artefatti runtime (non versionare)
data/bootstrap.log
data/crawl-once.log
data/chrome-profile/
AutoMotoRadar-Data/

# Credenziali accesso remoto (hash password + secret cookie) — MAI versionare
data/auth.json
# Config nodo worker (contiene la password app in chiaro) — MAI versionare
worker/node.config.json
# Bundle worker generato da esbuild (rigenerato al boot del server) — non versionare
worker/dist/
# Ricerche salvate utente (runtime)
data/saved-searches.json
# Segnalazioni bug-report utenti (runtime, può contenere testo libero) — MAI versionare
data/reports.jsonl

# app log (runtime)
data/logs/

# cache runtime prezzi carburante (si rigenera da sola ogni 12h)
data/carburanti-cache.json
# cache runtime listino Motornet (si rigenera da sola, TTL 7g) — dato di terzi: non entra nel repo
data/motornet-cache.json
# cache rilevamenti auto.it (si rigenera, TTL 7g) — dato di terzi: non entra nel repo
data/autoit-rilevamenti-cache.json
