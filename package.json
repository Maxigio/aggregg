{
  "name": "automotoradar",
  "version": "1.0.1",
  "description": "Comparatore prezzi auto e moto usate",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maxigio/aggregg.git"
  },
  "scripts": {
    "start": "node backend/server.js",
    "electron": "electron .",
    "postinstall": "node scripts/bundle-vendor.js",
    "prepare:mac": "node scripts/prepare-mac-chromium.js",
    "prepare:mac-arm64": "node scripts/prepare-mac-chromium-arm64.js",
    "prepare:mac-universal": "node scripts/prepare-mac-chromium-universal.js",
    "build:mac": "npm run prepare:mac && electron-builder --mac --x64",
    "build:mac-arm64": "npm run prepare:mac-arm64 && electron-builder --mac --arm64",
    "build:mac-universal": "npm run prepare:mac-universal && electron-builder --mac --universal",
    "dist:mac": "electron-builder --mac --x64",
    "dist:mac-arm64": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64",
    "test": "node --test test/*.test.js",
    "build:worker": "node scripts/build-worker-bundle.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.automotoradar.app",
    "productName": "Auto Moto Radar",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "pw-browsers",
        "to": "pw-browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Maxigio",
        "repo": "aggregg"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/icon.icns",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    },
    "files": [
      "electron/**",
      "backend/**",
      "frontend/**",
      "node_modules/**",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/bootstrap",
      "!node_modules/nouislider",
      "!node_modules/tom-select",
      "!node_modules/jspdf",
      "!node_modules/jspdf-autotable",
      "data/**",
      "!pw-browsers/**"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.3.0",
    "esbuild": "^0.28.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "nouislider": "^15.8.1",
    "tom-select": "^2.4.3"
  }
}
